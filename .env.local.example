# Web dashboard secrets. Copy to .env.local for local dev; in production these
# are set in the Amplify console (see amplify.yml).
#
# The Python bot in bot/ reads .env instead — see bot/.env.example. Keeping the
# two files apart is deliberate: Next.js loads both, but the bot loads only .env.

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Shared secret required by POST /api/dispatch when called from cron / external callers.
# Also signs the short-lived unlock cookie issued by the security gate.
DISPATCH_SECRET="change-me"

# 4-digit PIN for the manual-dispatch security gate. Leave unset to disable the
# gate entirely; when set, POST /api/dispatch rejects manual runs without a
# valid unlock, so the guard cannot be bypassed from the browser console.
DISPATCH_PIN="0000"

# Downstream trigger driver (lib/github.ts)
# Mode 1 - GitHub Actions workflow_dispatch / repository_dispatch.
# This repo triggers its own bot/ workflow, so OWNER/REPO point back here.
# The token needs a fine-grained PAT with "Actions: read and write".
GITHUB_TOKEN=""
GITHUB_OWNER="Mrigankar1134"
GITHUB_REPO="control-center"
GITHUB_WORKFLOW_ID="automation.yml"
GITHUB_REF="main"

# Mode 2 - Generic webhook (takes precedence when set)
DISPATCH_WEBHOOK_URL=""
DISPATCH_WEBHOOK_SECRET=""

# production | staging | development — drives the production dispatch warning
NEXT_PUBLIC_ENVIRONMENT="development"
