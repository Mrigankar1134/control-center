# Copy to .env for local runs. .env is gitignored; keep it that way.
# In CI these come from GitHub repo secrets instead (see automation.yml).

# --- Zoho People sign-in ---
ZOHO_EMAIL=
# Leave blank only if the account is passwordless (OTP-only).
ZOHO_PASSWORD=

# --- Gmail inbox that receives the Zoho OTP ---
GMAIL_ADDRESS=mrigankarofficial@gmail.com

# 16-character app password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). NOT your normal Google password. Spaces are
# stripped automatically, so pasting "abcd efgh ijkl mnop" is fine.
GMAIL_APP_PASSWORD=

# Optional
# Match your data centre: accounts.zoho.in / .eu / .com.au / .com
# FORM_URL=https://accounts.zoho.com/signin?servicename=zohopeople
# HEADLESS=false      # watch the browser locally
# OTP_TIMEOUT=120     # seconds to wait for the code
# OTP_SENDER=zohoaccounts  # substring match on the From header. The real
#                          # sender is noreply@zohoaccounts.in on the .in DC;
#                          # "zoho.com" matches nothing at all.

# --- Session reuse (skips password + OTP while the Zoho session lives) ---
# Fernet key encrypting state/zoho_state.enc. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in CI: without it the bot refuses to persist a session, because
# session cookies are login-equivalent and this repo is public.
# STATE_KEY=
# SESSION_REUSE=false     # force a full OTP sign-in every run
# STATE_MAX_AGE_DAYS=7    # discard a stored session older than this

# --- Anti-detection & debugging (all optional) ---
# STEALTH=false     # disable playwright-stealth fingerprint masking
# TRACE=on          # on | failure | off. Default: on in CI, off locally.
#                   # Writes trace.zip -> `playwright show-trace trace.zip`
#                   # for a step-by-step replay of the headless session.

# Only needed if Zoho starts blocking GitHub's datacenter IP ranges.
# PROXY_SERVER=http://residential-proxy.example.com:8000
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_BYPASS=*.internal.example.com
