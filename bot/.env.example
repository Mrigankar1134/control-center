# Copy to .env at the REPO ROOT (not inside bot/). .env is gitignored; keep it
# that way. On this branch there is no CI, so this file is the only place the
# bot's credentials live -- bot/cron.sh loads it for every scheduled run.

# --- Zoho People sign-in ---
ZOHO_EMAIL=
# Leave blank only if the account is passwordless (OTP-only).
ZOHO_PASSWORD=

# --- Gmail inbox that receives the Zoho OTP ---
# The inbox Zoho sends the code to, which need not be the Zoho address itself.
GMAIL_ADDRESS=

# 16-character app password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). NOT your normal Google password. Spaces are
# stripped automatically, so pasting "abcd efgh ijkl mnop" is fine.
GMAIL_APP_PASSWORD=

# --- Where the punch claims to be ---
# Zoho geofences the punch, so these have to be somewhere the account is
# allowed to punch from. Defaults are Pune / en-IN / Asia/Kolkata.
# PUNCH_LATITUDE=18.506154
# PUNCH_LONGITUDE=73.761416
# LOCALE=en-IN
# TIMEZONE_ID=Asia/Kolkata

# --- Scheduling (this branch runs from crontab, not GitHub Actions) ---
# bot/cron.sh sets these itself; override here only if you want different
# values. DISPATCH_MAX_JITTER_SEC is how far past the cron minute the punch may
# drift: 300 spreads a 09:15 cron across 09:15-09:20.
# DISPATCH_MAX_JITTER_SEC=300
# LOG_DIR=./logs

# --- The working day the check-out guard enforces ---
# Minutes. Default 570 (9h 30m). The bot refuses to punch out below this, so
# set it to whatever your employer actually requires.
# REQUIRED_MINUTES=570
# CHECKIN_EARLIEST=08:00   # stand down if a run arrives before this
# CHECKIN_LATEST=10:30     # stand down if it arrives after this
# CHECKOUT_DEADLINE=20:00  # never punch out past this
# MAX_CHECKOUT_WAIT_MIN=40 # how long to hold a short check-out open

# --- The dashboard this bot reports to ---
# Unset = the bot skips its policy read and always runs.
# CONTROL_CENTER_URL=https://main.xxxx.amplifyapp.com
# DISPATCH_SECRET=      # must equal the dashboard's own value

# --- Run notifications (optional, both or neither) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional
# Match your data centre: accounts.zoho.in / .eu / .com.au / .com
# FORM_URL=https://accounts.zoho.com/signin?servicename=zohopeople
# HEADLESS=false      # watch the browser locally
# OTP_TIMEOUT=120     # seconds to wait for the code
# OTP_SENDER=zohoaccounts  # substring match on the From header. The real
#                          # sender is noreply@zohoaccounts.in on the .in DC;
#                          # "zoho.com" matches nothing at all.

# --- Session reuse (skips password + OTP while the Zoho session lives) ---
# Fernet key encrypting state/zoho_state.enc. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in CI: without it the bot refuses to persist a session, because
# session cookies are login-equivalent and this repo is public.
# STATE_KEY=
# SESSION_REUSE=false     # force a full OTP sign-in every run
# STATE_MAX_AGE_DAYS=7    # discard a stored session older than this

# --- Anti-detection & debugging (all optional) ---
# STEALTH=false     # disable playwright-stealth fingerprint masking
# TRACE=on          # on | failure | off. Default: on in CI, off locally.
#                   # Writes trace.zip -> `playwright show-trace trace.zip`
#                   # for a step-by-step replay of the headless session.

# Only needed if Zoho starts blocking GitHub's datacenter IP ranges.
# PROXY_SERVER=http://residential-proxy.example.com:8000
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_BYPASS=*.internal.example.com
